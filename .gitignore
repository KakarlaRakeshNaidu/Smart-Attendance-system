# Track application source and required runtime/build files only.
# All other files are local by default, except the public setup README below.
*

# Repository rules, required license and application launch/deployment files.
!/.gitignore
!/LICENSE
!/package.json
!/package-lock.json
!/docker-compose.yml
!/render.yaml
!/.env.docker.example

# Frontend runtime and build configuration.
!/student-attendance-system/
!/student-attendance-system/client/
!/student-attendance-system/client/package.json
!/student-attendance-system/client/package-lock.json
!/student-attendance-system/client/index.html
!/student-attendance-system/client/vite.config.js
!/student-attendance-system/client/tailwind.config.js
!/student-attendance-system/client/postcss.config.js
!/student-attendance-system/client/vercel.json
!/student-attendance-system/client/Dockerfile
!/student-attendance-system/client/.dockerignore
!/student-attendance-system/client/nginx.conf
!/student-attendance-system/client/.env.example

# Frontend application source and assets.
!/student-attendance-system/client/src/
!/student-attendance-system/client/src/**/
!/student-attendance-system/client/src/**/*.[jt]s
!/student-attendance-system/client/src/**/*.[jt]sx
!/student-attendance-system/client/src/**/*.css
!/student-attendance-system/client/src/**/*.scss
!/student-attendance-system/client/src/**/*.json
!/student-attendance-system/client/src/**/*.svg
!/student-attendance-system/client/src/**/*.png
!/student-attendance-system/client/src/**/*.jpg
!/student-attendance-system/client/src/**/*.jpeg
!/student-attendance-system/client/src/**/*.webp
!/student-attendance-system/client/src/**/*.ico
!/student-attendance-system/client/src/**/*.woff
!/student-attendance-system/client/src/**/*.woff2
!/student-attendance-system/client/public/
!/student-attendance-system/client/public/**/*.html
!/student-attendance-system/client/public/**/*.js
!/student-attendance-system/client/public/**/*.css
!/student-attendance-system/client/public/**/*.json
!/student-attendance-system/client/public/**/*.webmanifest
!/student-attendance-system/client/public/**/*.svg
!/student-attendance-system/client/public/**/*.png
!/student-attendance-system/client/public/**/*.jpg
!/student-attendance-system/client/public/**/*.jpeg
!/student-attendance-system/client/public/**/*.webp
!/student-attendance-system/client/public/**/*.ico
!/student-attendance-system/client/public/**/*.woff
!/student-attendance-system/client/public/**/*.woff2
!/student-attendance-system/client/public/**/

# Backend runtime and deployment configuration.
!/student-attendance-system/server/
!/student-attendance-system/server/package.json
!/student-attendance-system/server/package-lock.json
!/student-attendance-system/server/vercel.json
!/student-attendance-system/server/Dockerfile
!/student-attendance-system/server/.dockerignore
!/student-attendance-system/server/.env.example
!/student-attendance-system/server/api/
!/student-attendance-system/server/api/**/
!/student-attendance-system/server/api/**/*.js
!/student-attendance-system/server/src/
!/student-attendance-system/server/src/**/
!/student-attendance-system/server/src/**/*.[jt]s
!/student-attendance-system/server/src/**/*.json
!/student-attendance-system/server/scripts/
!/student-attendance-system/server/scripts/**/
!/student-attendance-system/server/scripts/**/*.js
!/student-attendance-system/server/scripts/**/*.cjs
!/student-attendance-system/server/scripts/**/*.mjs

# Python face recognition service source and dependencies.
!/student-attendance-system/server/python/
!/student-attendance-system/server/python/**/
!/student-attendance-system/server/python/**/*.py
!/student-attendance-system/server/python/requirements.txt
!/student-attendance-system/server/python/Dockerfile
!/student-attendance-system/server/python/.dockerignore

# Never track tests, fixtures, reports or local verification tools.
test/
tests/
__tests__/
__mocks__/
fixtures/
verification/
coverage/
test-results/
playwright-report/
blob-report/
htmlcov/
*.test.*
*.spec.*
test_*.py
*_test.py
conftest.py
student-attendance-system/server/scripts/serve-fixtures.js

# Never track installed dependencies, generated files, uploads or model weights.
node_modules/
dist/
build/
.cache/
.vite/
.vite-temp/
__pycache__/
.venv/
venv/
.insightface/
uploads/
*.py[cod]
# Keep student records, biometric data and downloaded weights out of source trees.
data/
datasets/
student-data/
student_data/
face-embeddings/
face_embeddings/
embeddings/
students.json
attendance.json
embeddings.json
face_embeddings.json
face-embeddings.json
*.csv
*.xlsx
*.xls
*.bson
*.dump
*.sqlite*
*.db
*.onnx
*.pth
*.pt
*.ckpt
*.safetensors
*.npy
*.npz
*.pkl
*.pickle
*.h5
*.hdf5
*.log
*.bak
*.tmp
*.local.*
*Zone.Identifier*

# Local tooling, editor files and reports stay private.
.local-work/
.codex/
.chatgpt/
.github/
.vscode/
.idea/
graphify-out/
graphify/
.graphify/
AGENTS.md
CLAUDE.md
*.md
# Public installation, architecture and deployment instructions.
!/README.md

# Secrets stay local; only these non-secret configuration templates are allowed.
.env
.env.*
secrets.*
credentials.*
*.pem
*.key
*.p12
*.pfx
!/.env.docker.example
!/student-attendance-system/client/.env.example
!/student-attendance-system/server/.env.example
